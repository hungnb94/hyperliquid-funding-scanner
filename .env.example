# Hyperliquid API URL
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info

# Target coins as JSON array: [{"dex": "cash", "coin": "cash:WTI"}, {"dex": "km", "coin": "km:USOIL"}, ...]
# Leave dex empty string for first perp dex
TARGET_COINS=[{"dex": "cash", "coin": "cash:WTI"}, {"dex": "km", "coin": "km:USOIL"}, {"dex": "flx", "coin": "flx:OIL"}, {"dex": "xyz", "coin": "xyz:BRENTOIL"}]

# Scan interval in milliseconds (default: 1 hour)
SCAN_INTERVAL_MS=3600000

# CSV file path
CSV_FILE_PATH=./data/funding_rates.csv

# Log level: debug, info, warn, error
LOG_LEVEL=info